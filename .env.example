# ============================================================
# qmt-rpyc 服务端配置
# 推荐通过 qmt-rpyc-server init 生成配置。
# 源码脚本使用仓库 .env；安装包使用 %LOCALAPPDATA%\qmt-rpyc\config.env。
# 手工复制时，必须填写实际监听地址、密钥及 QMT_PATH。
# ============================================================

# --- 服务监听 ---
QMT_RPYC_HOST=192.168.1.20
QMT_RPYC_PORT=18812

# --- HMAC 认证密钥（服务端和客户端必须一致）---
QMT_RPYC_AUTH_KEY=your-secret-key-here
# 仅用于隔离测试环境；生产环境不要启用
# QMT_RPYC_ALLOW_INSECURE=0

# 原始 SDK 调试入口（默认关闭）；修改后需重启服务端
# QMT_RPYC_DEBUG=0

# --- QMT/MiniQMT 路径 ---
QMT_PATH=C:\path\to\MiniQMT\userdata_mini

# Optional: absolute xtquant package directory containing __init__.py.
# Empty uses existing Python import paths; invalid explicit paths fail without fallback.
# Restart after changing. This is independent of QMT_PATH.
QMT_XTQUANT_PATH=
QMT_SESSION_ID=1
# 留空仅使用行情；交易功能需填写实际账户
QMT_ACCOUNT_ID=

# --- TLS/SSL（可选，留空表示不使用 TLS）---
# QMT_RPYC_TLS_KEY=
# QMT_RPYC_TLS_CERT=
# QMT_RPYC_TLS_CA=

# --- 心跳检测（检测 QMT 是否意外断开）---
QMT_HEARTBEAT_INTERVAL=30
QMT_HEARTBEAT_TIMEOUT=5
QMT_HEARTBEAT_MAX_FAILURES=3

# --- 自动重连（10 秒、30 秒、1 分钟、之后每 10 分钟；0 = 不限次数）---
QMT_RECONNECT_MAX_ATTEMPTS=0

# --- 批量调用 ---
QMT_BATCH_MAX_WORKERS=8

# --- 日志 ---
# 默认使用服务端配置目录下的 logs
# QMT_RPYC_LOG_DIR=

# Server adapter implementation (requires restart; installed SDK is not changed).
QMT_RPYC_ADAPTER=xtquant_2.0.6.1
